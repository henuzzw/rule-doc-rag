APP_NAME=rule-doc-rag
APP_ENV=local

# PostgreSQL with pgvector. The docker-compose.yml in this project uses the
# same defaults.
DATABASE_URL=postgresql://rule_doc:rule_doc@localhost:5432/rule_doc

# mock: offline deterministic embedding for local demo/tests
# bge: use SentenceTransformers + BAAI/bge-large-zh-v1.5 by default
EMBEDDING_MODE=mock
EMBEDDING_DIMENSION=1024
BGE_MODEL_NAME=BAAI/bge-large-zh-v1.5

# mock: offline structured generator
# deepseek: call DeepSeek OpenAI-compatible chat API
# qianfan: call Baidu Qianfan coding endpoint via OpenAI-compatible chat API
LLM_MODE=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
QIANFAN_API_KEY=
QIANFAN_BASE_URL=https://qianfan.baidubce.com/v2/coding
QIANFAN_MODEL=qianfan-code-latest
QIANFAN_MAX_TOKENS=8192
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

RAG_TOP_K=5
